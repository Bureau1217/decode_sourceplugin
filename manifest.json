{
  "manifest_version": 3,
  "name": "Source Reliability Plugin",
  "short_name": "SourceReliability",
  "version": "0.1.0",
  "description": "Displays a trust score next to each source in Google search results, based on a community-maintained reliability database.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.google.com/*",
    "https://google.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Source Reliability Plugin",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://google.com/search*"
      ],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/sources.json"],
      "matches": [
        "https://www.google.com/*"
      ]
    }
  ]
}
